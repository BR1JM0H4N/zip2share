<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
            colorSurfaceVariant is a tinted, mid-tone colour derived from the
            system palette — darker/richer than plain white on light theme,
            lighter/softer on dark theme. Perfect for the status-bar area.
        -->
        <item name="android:statusBarColor">?attr/colorSurfaceVariant</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />
</resources>
