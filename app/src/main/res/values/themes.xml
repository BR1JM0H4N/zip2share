<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 DayNight theme — automatically switches between light and dark
        based on the system setting (AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM).

        On Android 12+ the Monet/dynamic colour engine injects colorPrimary etc.
        automatically. On older devices Material3 uses its built-in teal/purple
        fallback palette.
    -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Edge-to-edge: draw under status bar and navigation bar -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ensure system icon tint follows theme -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />
</resources>
